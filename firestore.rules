rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an authenticated administrator
    function isAdmin() {
      return request.auth != null && 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.token.admin == true);
    }
    
    // Products Collection
    // Public can read active products. Only admins can create, update, or delete.
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }
    
    // Settings Document
    // Public can read site settings (WhatsApp number, social links, contact info).
    // Only admins can write settings.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Homepage Content Document
    // Public can read homepage editorial content.
    // Only admins can update hero, vision, mission, and copy.
    match /homepage/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Affiliates Collection
    // Public can read active affiliates for coupon validation and referral links.
    // Only authenticated administrators can create, modify, or delete affiliate records.
    match /affiliates/{affiliateId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Orders Collection
    // Public can submit an initial pending order via WhatsApp ordering flow.
    // Only authenticated admins can read, update status, confirm, or delete orders.
    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'pending' &&
                       request.resource.data.commissionStatus == 'pending';
      allow read, update, delete: if isAdmin();
    }
    
    // Admins Collection
    // Only existing admins can read the admin list or add new admins.
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
